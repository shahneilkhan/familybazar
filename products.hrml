  <!-- =====================================================
       JAVASCRIPT
       ===================================================== -->

  <script src="script.js"></script>


  <!-- =====================================================
       PRODUCTS PAGE JAVASCRIPT
       ===================================================== -->

  <script>

    "use strict";


    /* =====================================================
       PRODUCTS PAGE STATE
       ===================================================== */

    let pageCategory = "all";

    let pageSearch = "";

    let minPrice = 0;

    let maxPrice = Infinity;

    let onlyStock = false;

    let onlyDiscount = false;

    let sortMode = "default";


    /* =====================================================
       DOM
       ===================================================== */

    const productsGrid =
      document.getElementById(
        "productsGrid"
      );

    const resultCount =
      document.getElementById(
        "resultCount"
      );

    const searchForm =
      document.getElementById(
        "productSearchForm"
      );

    const searchInput =
      document.getElementById(
        "productSearch"
      );

    const sortProducts =
      document.getElementById(
        "sortProducts"
      );

    const minPriceInput =
      document.getElementById(
        "minPrice"
      );

    const maxPriceInput =
      document.getElementById(
        "maxPrice"
      );

    const inStockFilter =
      document.getElementById(
        "inStockFilter"
      );

    const discountFilter =
      document.getElementById(
        "discountFilter"
      );

    const clearFilters =
      document.getElementById(
        "clearFilters"
      );

    const mobileFilterBtn =
      document.getElementById(
        "mobileFilterBtn"
      );

    const filterSidebar =
      document.getElementById(
        "filterSidebar"
      );


    /* =====================================================
       GET URL PARAMETERS
       ===================================================== */

    const params =
      new URLSearchParams(
        window.location.search
      );


    if (
      params.get("category")
    ) {

      pageCategory =
        normalizeCategory(
          params.get("category")
        );

    }


    if (
      params.get("search")
    ) {

      pageSearch =
        params.get("search")
          .trim()
          .toLowerCase();

      searchInput.value =
        params.get("search");

    }


    /* =====================================================
       CATEGORY NORMALIZER
       ===================================================== */

    function normalizeCategory(
      category
    ) {

      const value =
        String(category || "")
          .trim()
          .toLowerCase();

      const aliases = {

        "rice & grains": "rice",
        "rice-grains": "rice",
        "oil & ghee": "oil",
        "oil-ghee": "oil",
        "personal care": "personal",
        "all products": "all"

      };

      return (
        aliases[value] ||
        value ||
        "all"
      );

    }


    /* =====================================================
       CATEGORY BUTTONS
       ===================================================== */

    document
      .querySelectorAll(
        ".category-filter"
      )
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            pageCategory =
              normalizeCategory(
                button.dataset.filterCategory
              );

            updateCategoryButtons();

            applyProductFilters();

          }
        );

      });


    function updateCategoryButtons() {

      document
        .querySelectorAll(
          ".category-filter"
        )
        .forEach(button => {

          const category =
            normalizeCategory(
              button.dataset.filterCategory
            );

          button.classList.toggle(
            "active",
            category === pageCategory
          );

        });

    }


    /* =====================================================
       SEARCH
       ===================================================== */

    searchForm.addEventListener(
      "submit",
      event => {

        event.preventDefault();

        pageSearch =
          searchInput.value
            .trim()
            .toLowerCase();

        applyProductFilters();

      }
    );


    /* =====================================================
       LIVE SEARCH
       ===================================================== */

    searchInput.addEventListener(
      "input",
      () => {

        pageSearch =
          searchInput.value
            .trim()
            .toLowerCase();

        applyProductFilters();

      }
    );


    /* =====================================================
       SORT
       ===================================================== */

    sortProducts.addEventListener(
      "change",
      () => {

        sortMode =
          sortProducts.value;

        sortProductCards();

        applyProductFilters();

      }
    );


    /* =====================================================
       PRICE FILTER
       ===================================================== */

    document
      .getElementById(
        "applyPrice"
      )
      .addEventListener(
        "click",
        () => {

          const min =
            Number(
              minPriceInput.value
            );

          const max =
            Number(
              maxPriceInput.value
            );

          minPrice =
            Number.isFinite(min) &&
            min > 0
              ? min
              : 0;

          maxPrice =
            Number.isFinite(max) &&
            max > 0
              ? max
              : Infinity;

          applyProductFilters();

        }
      );


    /* =====================================================
       STOCK FILTER
       ===================================================== */

    inStockFilter.addEventListener(
      "change",
      () => {

        onlyStock =
          inStockFilter.checked;

        applyProductFilters();

      }
    );


    /* =====================================================
       DISCOUNT FILTER
       ===================================================== */

    discountFilter.addEventListener(
      "change",
      () => {

        onlyDiscount =
          discountFilter.checked;

        applyProductFilters();

      }
    );


    /* =====================================================
       CLEAR FILTERS
       ===================================================== */

    clearFilters.addEventListener(
      "click",
      () => {

        pageCategory = "all";

        pageSearch = "";

        minPrice = 0;

        maxPrice = Infinity;

        onlyStock = false;

        onlyDiscount = false;

        sortMode = "default";

        searchInput.value = "";

        minPriceInput.value = "";

        maxPriceInput.value = "";

        inStockFilter.checked = false;

        discountFilter.checked = false;

        sortProducts.value = "default";

        updateCategoryButtons();

        applyProductFilters();

      }
    );


    /* =====================================================
       MOBILE FILTER
       ===================================================== */

    mobileFilterBtn.addEventListener(
      "click",
      () => {

        filterSidebar.classList.toggle(
          "mobile-open"
        );

        mobileFilterBtn.textContent =
          filterSidebar.classList.contains(
            "mobile-open"
          )
            ? "✕  Close Filters"
            : "☰  Filter Products";

      }
    );


    /* =====================================================
       SORT PRODUCT CARDS
       ===================================================== */

    function sortProductCards() {

      const cards =
        [
          ...productsGrid.querySelectorAll(
            ".product-card"
          )
        ];

      if (
        sortMode === "default"
      ) {

        cards.sort(
          (a, b) =>
            Number(
              a.dataset.originalOrder || 0
            ) -
            Number(
              b.dataset.originalOrder || 0
            )
        );

      }


      if (
        sortMode === "price-low"
      ) {

        cards.sort(
          (a, b) =>
            Number(a.dataset.price || 0) -
            Number(b.dataset.price || 0)
        );

      }


      if (
        sortMode === "price-high"
      ) {

        cards.sort(
          (a, b) =>
            Number(b.dataset.price || 0) -
            Number(a.dataset.price || 0)
        );

      }


      if (
        sortMode === "name-az"
      ) {

        cards.sort(
          (a, b) => {

            const nameA =
              a.querySelector(
                ".product-title"
              )?.textContent
                .trim()
                .toLowerCase() || "";

            const nameB =
              b.querySelector(
                ".product-title"
              )?.textContent
                .trim()
                .toLowerCase() || "";

            return nameA.localeCompare(
              nameB
            );

          }
        );

      }


      if (
        sortMode === "name-za"
      ) {

        cards.sort(
          (a, b) => {

            const nameA =
              a.querySelector(
                ".product-title"
              )?.textContent
                .trim()
                .toLowerCase() || "";

            const nameB =
              b.querySelector(
                ".product-title"
              )?.textContent
                .trim()
                .toLowerCase() || "";

            return nameB.localeCompare(
              nameA
            );

          }
        );

      }


      cards.forEach(card => {

        productsGrid.appendChild(
          card
        );

      });

    }


    /* =====================================================
       SAVE ORIGINAL ORDER
       ===================================================== */

    document
      .querySelectorAll(
        "#productsGrid .product-card"
      )
      .forEach(
        (card, index) => {

          card.dataset.originalOrder =
            index;

        }
      );


    /* =====================================================
       APPLY ALL FILTERS
       ===================================================== */

    function applyProductFilters() {

      const cards =
        [
          ...productsGrid.querySelectorAll(
            ".product-card"
          )
        ];

      let visible = 0;


      cards.forEach(card => {

        const category =
          normalizeCategory(
            card.dataset.category
          );

        const price =
          Number(
            card.dataset.price || 0
          );

        const stock =
          card.dataset.stock ===
          "true";

        const badge =
          card.querySelector(
            ".product-badge"
          );

        const title =
          card.querySelector(
            ".product-title"
          )?.textContent
            .trim()
            .toLowerCase() || "";

        const brand =
          card.querySelector(
            ".product-brand"
          )?.textContent
            .trim()
            .toLowerCase() || "";


        const categoryMatch =
          pageCategory === "all" ||
          category === pageCategory;


        const searchMatch =
          !pageSearch ||
          title.includes(pageSearch) ||
          brand.includes(pageSearch) ||
          category.includes(pageSearch);


        const priceMatch =
          price >= minPrice &&
          price <= maxPrice;


        const stockMatch =
          !onlyStock ||
          stock;


        const discountMatch =
          !onlyDiscount ||
          !!badge;


        const show =
          categoryMatch &&
          searchMatch &&
          priceMatch &&
          stockMatch &&
          discountMatch;


        card.style.display =
          show
            ? ""
            : "none";


        if (show) {
          visible++;
        }

      });


      resultCount.textContent =
        visible;


      showNoProducts(
        visible === 0
      );

    }


    /* =====================================================
       NO PRODUCTS
       ===================================================== */

    function showNoProducts(
      show
    ) {

      const existing =
        productsGrid.querySelector(
          ".no-products"
        );

      if (
        show &&
        !existing
      ) {

        const empty =
          document.createElement(
            "div"
          );

        empty.className =
          "no-products";

        empty.innerHTML = `

          <div class="no-products-icon">
            🔎
          </div>

          <h2>
            No products found
          </h2>

          <p>
            Try another search or change your filters.
          </p>

          <button
            type="button"
            class="btn btn-primary"
            id="emptyClearButton"
          >
            Clear Filters
          </button>

        `;

        productsGrid.appendChild(
          empty
        );


        document
          .getElementById(
            "emptyClearButton"
          )
          .addEventListener(
            "click",
            () => {

              clearFilters.click();

            }
          );

      }


      if (
        !show &&
        existing
      ) {

        existing.remove();

      }

    }


    /* =====================================================
       INITIALIZE
       ===================================================== */

    updateCategoryButtons();

    sortProductCards();

    applyProductFilters();


    /* =====================================================
       CART DRAWER
       Compatibility enhancement
       ===================================================== */

    const cartButton =
      document.querySelector(
        "[data-open-cart]"
      );

    const cartDrawer =
      document.querySelector(
        ".cart-drawer"
      );

    const cartOverlay =
      document.querySelector(
        ".cart-drawer-overlay"
      );


    if (
      cartButton &&
      cartDrawer
    ) {

      cartButton.addEventListener(
        "click",
        () => {

          cartDrawer.classList.add(
            "active"
          );

          cartOverlay?.classList.add(
            "active"
          );

          document.body.classList.add(
            "no-scroll"
          );

        }
      );

    }


    /* =====================================================
       UPDATE CART AFTER PAGE LOAD
       ===================================================== */

    if (
      window.FamilyBazar &&
      window.FamilyBazar.cart
    ) {

      const count =
        window.FamilyBazar.cart.count();

      document
        .querySelectorAll(
          ".cart-count"
        )
        .forEach(
          element => {

            element.textContent =
              count;

          }
        );

    }

  </script>

</body>
</html>
